generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  password      String?         // Hashed password for Credentials provider
  name          String?
  image         String?
  tasks         Task[]
  personas      Persona[]
  browserContexts BrowserContext[]
  apiKeys       ApiKey[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String   @unique // Hashed key
  name        String   // Friendly name for the key (e.g. "Dev Laptop")
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        String
  status      TaskStatus @default(PENDING)
  steps       TaskStep[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model TaskStep {
  id           String     @id @default(cuid())
  taskId       String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepIndex    Int
  description  String
  action       Json       // The JSON action defined by the AI
  status       StepStatus @default(PENDING)
  result       String?    // Success message or extraction result
  error        String?    // Detailed error message if failed
  screenshotUrl String?   // Pointer to cloud storage screenshot
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([taskId])
}

model Persona {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // Friendly name of the persona
  data        String   // AES-encrypted JSON string containing Name, Email, Job, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model BrowserContext {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String   @unique // Playwright session ID
  storageState Json     // Serialized cookies and local storage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
